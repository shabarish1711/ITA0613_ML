# ====================================
# INDEXING / APPROXIMATION PROTOTYPE
# ====================================

np.random.seed(20)

n = 200000

X = np.random.random(
    (n, 2)
)

y = (

    3 * X[:, 0]

    +

    2 * X[:, 1]
)

query = np.array(
    [0.55, 0.60]
)

# ------------------------------------
# BRUTE FORCE
# ------------------------------------

start = time.perf_counter()

distances = np.sqrt(

    np.sum(

        (
            X - query
        ) ** 2,

        axis=1
    )
)

nearest = np.argpartition(

    distances,

    5
)[:5]

normal_prediction = np.mean(
    y[nearest]
)

normal_time = (

    time.perf_counter()

    -

    start
)

# ------------------------------------
# GRID INDEX
# ------------------------------------

bin_size = 0.1

grid_x = (

    X[:, 0]

    /

    bin_size
).astype(int)

grid_y = (

    X[:, 1]

    /

    bin_size
).astype(int)

query_x = int(

    query[0]

    /

    bin_size
)

query_y = int(

    query[1]

    /

    bin_size
)

start = time.perf_counter()

candidate_mask = (

    (
        abs(
            grid_x - query_x
        )
        <= 1
    )

    &

    (
        abs(
            grid_y - query_y
        )
        <= 1
    )
)

candidates = X[
    candidate_mask
]

candidate_y = y[
    candidate_mask
]

candidate_distances = np.sqrt(

    np.sum(

        (
            candidates - query
        ) ** 2,

        axis=1
    )
)

nearest = np.argpartition(

    candidate_distances,

    5
)[:5]

indexed_prediction = np.mean(

    candidate_y[
        nearest
    ]
)

indexed_time = (

    time.perf_counter()

    -

    start
)

print(
    "\nINDEXING RESULTS"
)

print(
    "Total Records:",
    len(X)
)

print(
    "Candidate Records:",
    len(candidates)
)

print(
    "Brute Force Time:",
    normal_time
)

print(
    "Indexed Search Time:",
    indexed_time
)

print(
    "Brute Force Prediction:",
    normal_prediction
)

print(
    "Indexed Prediction:",
    indexed_prediction
)

print(
    "Speed Improvement:",
    normal_time
    /
    indexed_time
)
