import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import time

# ------------------------------------
# QUESTION E
# SCALABILITY ANALYSIS
# ------------------------------------

np.random.seed(100)

dataset_sizes = [

    1000,

    10000,

    100000,

    1000000
]

knn_times = []

lwr_times = []

memory_values = []

for n in dataset_sizes:

    print(
        "\nTesting Dataset Size:",
        n
    )

    # Generate benchmark data
    X = np.random.random(
        (n, 5)
    )

    y = (

        2 * X[:, 0]

        + X[:, 1]

        - X[:, 2]

        + np.random.normal(
            0,
            0.05,
            n
        )
    )

    query = np.random.random(
        5
    )

    # --------------------------------
    # KNN EXECUTION TIME
    # --------------------------------

    start_time = (
        time.perf_counter()
    )

    distances = np.sqrt(

        np.sum(

            (
                X - query
            ) ** 2,

            axis=1
        )
    )

    k = 5

    nearest = np.argpartition(

        distances,

        k
    )[:k]

    knn_prediction = np.mean(

        y[nearest]
    )

    knn_time = (

        time.perf_counter()

        -

        start_time
    )

    # --------------------------------
    # LWR EXECUTION TIME
    # --------------------------------

    start_time = (
        time.perf_counter()
    )

    weights = np.exp(

        -

        np.sum(

            (
                X - query
            ) ** 2,

            axis=1
        )

        /

        0.2
    )

    lwr_prediction = (

        np.sum(
            weights * y
        )

        /

        (
            np.sum(weights)
            +
            1e-10
        )
    )

    lwr_time = (

        time.perf_counter()

        -

        start_time
    )

    memory_mb = (

        X.nbytes

        +

        y.nbytes

    ) / (1024 ** 2)

    knn_times.append(
        knn_time
    )

    lwr_times.append(
        lwr_time
    )

    memory_values.append(
        memory_mb
    )

    print(
        "k-NN Time:",
        round(
            knn_time,
            6
        ),
        "seconds"
    )

    print(
        "LWR Time:",
        round(
            lwr_time,
            6
        ),
        "seconds"
    )

    print(
        "Memory Usage:",
        round(
            memory_mb,
            2
        ),
        "MB"
    )

# ------------------------------------
# RESULT TABLE
# ------------------------------------

results = pd.DataFrame({

    "Records":
    dataset_sizes,

    "KNN_Time":
    knn_times,

    "LWR_Time":
    lwr_times,

    "Memory_MB":
    memory_values
})

print(
    "\nScalability Results"
)

print(results)

results.to_csv(
    "results/question_e_scalability.csv",
    index=False
)

