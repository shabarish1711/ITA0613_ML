import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------------
# QUESTION A
# DATA ENGINEERING AND EDA
# ------------------------------------

np.random.seed(42)

n = 12000

data = pd.DataFrame({
    "Year": np.random.choice([2021, 2022, 2023], n),

    "District": np.random.choice(
        [
            "Chennai",
            "Madurai",
            "Coimbatore",
            "Salem",
            "Trichy",
            "Thanjavur"
        ],
        n
    ),

    "Season": np.random.choice(
        ["Kharif", "Rabi", "Summer"],
        n
    ),

    "Rainfall": np.random.normal(
        950, 250, n
    ),

    "Temperature": np.random.normal(
        27, 4, n
    ),

    "Humidity": np.random.normal(
        70, 12, n
    ),

    "Soil_Moisture": np.random.normal(
        45, 10, n
    ),

    "pH": np.random.normal(
        6.5, 0.6, n
    )
})

# Generate crop yield
data["Yield"] = (
    2
    + 0.002 * data["Rainfall"]
    - 0.04 * abs(data["Temperature"] - 26)
    + 0.01 * data["Soil_Moisture"]
    + np.random.normal(0, 0.35, n)
)

# ------------------------------------
# INTRODUCE MISSING VALUES
# ------------------------------------

for column in [
    "Rainfall",
    "Temperature",
    "Humidity"
]:

    missing_rows = np.random.choice(
        data.index,
        200,
        replace=False
    )

    data.loc[
        missing_rows,
        column
    ] = np.nan

print("Original Dataset")
print(data.head())

print("\nDataset Shape:")
print(data.shape)

print("\nMissing Values Before Cleaning:")
print(data.isnull().sum())

# ------------------------------------
# MISSING VALUE IMPUTATION
# ------------------------------------

for column in [
    "Rainfall",
    "Temperature",
    "Humidity"
]:

    median_value = data[column].median()

    data[column] = data[column].fillna(
        median_value
    )

print("\nMissing Values After Cleaning:")
print(data.isnull().sum())

# ------------------------------------
# FEATURE ENGINEERING
# ------------------------------------

# Feature 1 - Growing Degree Days
base_temperature = 10

data["GDD"] = np.maximum(
    data["Temperature"] - base_temperature,
    0
) * 120

# Feature 2 - Rainfall Anomaly
rainfall_mean = data["Rainfall"].mean()
rainfall_std = data["Rainfall"].std()

data["Rainfall_Anomaly"] = (
    data["Rainfall"] - rainfall_mean
) / rainfall_std

# Feature 3 - Temperature Humidity Index
data["Temperature_Humidity_Index"] = (
    data["Temperature"]
    * data["Humidity"]
) / 100

print("\nDataset After Feature Engineering:")
print(data.head())

print("\nStatistical Summary:")
print(data.describe())

# Save cleaned dataset
data.to_csv(
    "QUESTION_A_CLEANED_DATA.csv",
    index=False
)

# ------------------------------------
# GRAPH 1 - RAINFALL VS YIELD
# ------------------------------------

plt.figure(figsize=(8, 5))

plt.scatter(
    data["Rainfall"][:2000],
    data["Yield"][:2000],
    alpha=0.4
)

plt.xlabel("Rainfall (mm)")
plt.ylabel("Crop Yield")

plt.title(
    "Relationship Between Rainfall and Crop Yield"
)

plt.grid()

plt.tight_layout()
plt.savefig("results/question_a_rainfall_yield.png")
plt.show()

# ------------------------------------
# GRAPH 2 - YEAR VS YIELD
# ------------------------------------

yearly_yield = (
    data.groupby("Year")["Yield"]
    .mean()
)

plt.figure(figsize=(7, 5))

yearly_yield.plot(
    kind="bar"
)

plt.xlabel("Year")
plt.ylabel("Average Crop Yield")

plt.title(
    "Average Crop Yield by Year"
)

plt.grid(axis="y")

plt.tight_layout()
plt.savefig("results/question_a_year_yield.png")
plt.show()

# ------------------------------------
# GRAPH 3 - TEMPERATURE VS YIELD
# ------------------------------------

plt.figure(figsize=(8, 5))

plt.scatter(
    data["Temperature"][:2000],
    data["Yield"][:2000],
    alpha=0.4
)

plt.xlabel("Temperature (°C)")
plt.ylabel("Crop Yield")

plt.title(
    "Temperature vs Crop Yield"
)

plt.grid()

plt.tight_layout()
plt.savefig("results/question_a_temperature_yield.png")
plt.show()
